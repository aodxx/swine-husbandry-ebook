#!/usr/bin/env python3
from pathlib import Path
import json

ROOT=Path(__file__).resolve().parents[1]
d=json.loads((ROOT/'data/research-status.json').read_text(encoding='utf-8'))
topics=d['topics']; counts={s:sum(t.get('status')==s for t in topics) for s in d['allowed_statuses']}
order=['TODO','RESEARCHING','SOURCES_COLLECTED','FACTS_EXTRACTED','DRAFTED','FACT_CHECKED','EDITORIAL_REVIEW','APPROVED','PUBLISHED','BLOCKED','HIGH_RISK_REVIEW','PENDING_FARM_HISTORY','NEEDS_UPDATE']
idx={s:i for i,s in enumerate(order)}
def at_least(s): return sum(idx.get(t.get('status'),-1)>=idx[s] for t in topics)
focus=next(t for t in topics if t['id']==d['current_focus'])
nextt=next(t for t in topics if t['id']==d['next_topic'])
chapter1=d.get('chapter_closures',{}).get('1',{})
lock_note=d.get('workflow_state','')
lines=['# Project Progress','',f"Generated from `data/research-status.json` on {d.get('last_updated','unknown')}. Do not edit counts manually.",'','## Current Project State','',f"Chapter 1 status: `{chapter1.get('status','NOT_RECORDED')}`. Current Focus is `{focus['id']}` — {focus['title']}. Next Topic is `{nextt['id']}` — {nextt['title']}; `{lock_note}`.",'','## Current State Count','', '| Status | Count |','|---|---:|']
for s in order: lines.append(f'| {s} | {counts.get(s,0)} |')
lines += ['', '## Milestone Count (cumulative)', '', '| Milestone reached | Count |','|---|---:|',f'| Drafted or beyond | {at_least("DRAFTED")} |',f'| Fact checked or beyond | {at_least("FACT_CHECKED")} |',f'| Editorial review or beyond | {at_least("EDITORIAL_REVIEW")} |',f'| Approved | {counts.get("APPROVED",0)} |',f'| Published | {counts.get("PUBLISHED",0)} |','', '## Current Focus','',f"- **Current Topic:** `{focus['id']}` — {focus['title']}",f"- **Next Topic:** `{nextt['id']}` — {nextt['title']}",f"- **Next Topic Gate:** `{lock_note}`",f"- **Research status:** `{focus['status']}`",f"- **Last reviewed:** {focus.get('last_reviewed')}", '', '## Foundation Checklist','', '- [x] Content/Research Foundation: governing documents, Master TOC, status registry, research workspace, source registry/schema, and content schema', '- [ ] Reader/App Foundation', '- [x] Persistent validation scripts for content, sources, status, and TOC', '- [x] CI validation on push and pull request', '', '## State Governance','', '- `data/research-status.json` is the Single Source of Truth for topic status.', '- Content front matter must match the status registry before merge.', '- This file is generated; update the registry, then run `scripts/generate-progress`.','']
(ROOT/'PROGRESS.md').write_text('\n'.join(lines),encoding='utf-8')
print(f'Generated PROGRESS.md from {len(topics)} topics; focus={focus["id"]}; status={focus["status"]}')
